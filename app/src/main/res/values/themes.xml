<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Somafern" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy_background</item>
        <item name="android:statusBarColor">@color/navy_background</item>
        <item name="android:navigationBarColor">@color/navy_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Android 12+ System Splash Screen Theme Override -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/navy_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@color/transparent</item>
    </style>
</resources>